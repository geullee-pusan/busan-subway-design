diff --git a/src/ui/render-quality.js b/src/ui/render-quality.js
new file mode 100644
index 0000000..442c35a
--- /dev/null
+++ b/src/ui/render-quality.js
@@ -0,0 +1,200 @@
+// 3D 화면 품질: '보통'(지금 그림) 또는 '실감'(더 실감 나게).
+// 실감은 three.js 패키지에 들어 있는 기능만 쓴다(새 의존성 없음, 네트워크 없음).
+//  - 재질: 빛을 단순하게 받는 재질(Lambert)을 빛 반사를 셈하는 재질(Standard)로 바꾼다. 금속·유리는 반짝이고 천·벽은 무광.
+//  - 주변 반사: 방 모양 빛(RoomEnvironment)을 코드로 만들어 모든 면이 은은하게 받는다.
+//  - 색 다듬기: ACES 톤 매핑(밝은 곳이 하얗게 날아가지 않는다).
+//  - 모서리 그늘: GTAO.
+//  - 불빛 번짐: 밝은 천장 불빛과 창밖 햇빛이 살짝 번진다(Bloom).
+//  - 계단 현상 줄이기: SMAA.
+// 넓은 바깥 풍경에서는 색 다듬기가 하늘과 풀빛을 바래게 해서, 실감은 가까이 보는 장면(객실, 승강장, 대합실)에만 쓴다.
+// 태블릿에서 무거울 수 있어 고를 수 있게 둔다(기본은 보통).
+import { ACESFilmicToneMapping, Color, MeshStandardMaterial, NoToneMapping, PMREMGenerator, Vector2 } from 'three';
+import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
+import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
+import { GTAOPass } from 'three/addons/postprocessing/GTAOPass.js';
+import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';
+import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
+import { SMAAPass } from 'three/addons/postprocessing/SMAAPass.js';
+import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
+
+export const QUALITIES = ['보통', '실감'];
+
+/** 색으로 어림한 표면: 아주 밝은 회색·은색은 금속(손잡이, 기둥), 나머지는 무광(우리가 정한 값) */
+function finishOf(material) {
+  if (material.transparent && material.opacity < 0.9) return { roughness: 0.08, metalness: 0.0 }; // 유리
+  if (material.vertexColors) return { roughness: 0.62, metalness: 0.04 };
+  const c = material.color ?? new Color(1, 1, 1);
+  const grey = Math.abs(c.r - c.g) < 0.04 && Math.abs(c.g - c.b) < 0.04;
+  if (grey && c.r > 0.55) return { roughness: 0.32, metalness: 0.55 };
+  return { roughness: 0.7, metalness: 0.02 };
+}
+
+/** Lambert 재질 하나를 같은 생김새의 Standard 재질로 */
+function upgrade(m) {
+  const s = new MeshStandardMaterial({
+    color: m.color,
+    map: m.map,
+    vertexColors: m.vertexColors,
+    side: m.side,
+    transparent: m.transparent,
+    opacity: m.opacity,
+    emissive: m.emissive,
+    emissiveIntensity: m.emissiveIntensity,
+    emissiveMap: m.emissiveMap,
+    flatShading: m.flatShading,
+    depthWrite: m.depthWrite,
+    polygonOffset: m.polygonOffset,
+    polygonOffsetFactor: m.polygonOffsetFactor,
+    polygonOffsetUnits: m.polygonOffsetUnits,
+    ...finishOf(m),
+  });
+  s.name = m.name;
+  return s;
+}
+
+/**
+ * @param {import('three').WebGLRenderer} renderer
+ * @param {import('three').Scene} scene
+ * @param {import('three').PerspectiveCamera} camera
+ */
+export function createQuality(renderer, scene, camera) {
+  let level = '보통';
+  /** 지금 그림에 실감을 쓰는지(실감을 골랐고 가까이 보는 장면일 때만) */
+  let active = false;
+  /** Lambert → Standard(한 번 만든 것은 다시 쓴다) */
+  const toGood = new WeakMap();
+  /** Standard → 원래 Lambert */
+  const toPlain = new WeakMap();
+  const made = new Set();
+  let env = null;
+  let composer = null;
+  let ao = null;
+  let smaa = null;
+  let bloom = null;
+  let near = false;
+  let sweepAt = 0;
+  const size = { w: 0, h: 0 };
+
+  function swap(root) {
+    root.traverse((o) => {
+      if (!o.isMesh || !o.material) return;
+      const one = (m) => {
+        if (active) {
+          if (!m.isMeshLambertMaterial) return m;
+          let s = toGood.get(m);
+          if (!s) {
+            s = upgrade(m);
+            toGood.set(m, s);
+            toPlain.set(s, m);
+            made.add(s);
+          }
+          return s;
+        }
+        return toPlain.get(m) ?? m;
+      };
+      o.material = Array.isArray(o.material) ? o.material.map(one) : one(o.material);
+    });
+  }
+
+  function ensureGood() {
+    if (!env) {
+      const pmrem = new PMREMGenerator(renderer);
+      env = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
+      pmrem.dispose();
+    }
+    if (!composer) {
+      composer = new EffectComposer(renderer);
+      composer.setPixelRatio(1); // 화면 효과는 1배로(태블릿 부담을 줄인다)
+      composer.addPass(new RenderPass(scene, camera));
+      ao = new GTAOPass(scene, camera, 640, 400);
+      ao.output = GTAOPass.OUTPUT.Default;
+      ao.blendIntensity = 1;
+      ao.updateGtaoMaterial({ radius: 0.9, distanceExponent: 1.2, thickness: 1.5, scale: 1.2, samples: 12 });
+      composer.addPass(ao);
+      bloom = new UnrealBloomPass(new Vector2(640, 400), 0.28, 0.5, 0.88);
+      composer.addPass(bloom);
+      composer.addPass(new OutputPass());
+      smaa = new SMAAPass();
+      composer.addPass(smaa);
+      if (size.w) composer.setSize(size.w, size.h);
+    }
+  }
+
+  /** 장면의 빛 세기: 실감에서는 주변 반사가 빛을 더하므로 원래 빛을 줄인다(우리가 정한 값) */
+  function scaleLights(k) {
+    scene.traverse((o) => {
+      if (!o.isLight) return;
+      if (o.userData.baseIntensity === undefined) o.userData.baseIntensity = o.intensity;
+      o.intensity = o.userData.baseIntensity * k;
+    });
+  }
+
+  function apply() {
+    active = level === '실감' && near;
+    if (active) {
+      ensureGood();
+      scene.environment = env;
+      scene.environmentIntensity = 0.45;
+      renderer.toneMapping = ACESFilmicToneMapping;
+      renderer.toneMappingExposure = 0.95;
+      scaleLights(0.62);
+    } else {
+      scaleLights(1);
+      scene.environment = null;
+      renderer.toneMapping = NoToneMapping;
+      renderer.toneMappingExposure = 1;
+    }
+    swap(scene);
+  }
+
+  return {
+    get level() {
+      return level;
+    },
+    setLevel(next) {
+      if (!QUALITIES.includes(next) || next === level) return;
+      level = next;
+      apply();
+    },
+    /** 지금 실감으로 그리는지 */
+    get active() {
+      return active;
+    },
+    /** 가까이 보는 장면(객실, 승강장, 대합실)인지: 모서리 그늘을 켠다 */
+    setNear(value) {
+      if (near === value) return;
+      near = value;
+      apply();
+    },
+    /** 바꿔 끼운 재질이면 원래 재질(구간을 버릴 때 함께 지운다) */
+    original(m) {
+      return toPlain.get(m) ?? null;
+    },
+    setSize(w, h) {
+      size.w = w;
+      size.h = h;
+      composer?.setSize(w, h);
+    },
+    /** 한 장 그린다. 새로 지은 것(구간이 바뀌면 생기는 땅·역)도 0.5초마다 재질을 맞춘다. */
+    render(now = 0) {
+      if (!active) {
+        renderer.render(scene, camera);
+        return;
+      }
+      if (now - sweepAt > 500) {
+        sweepAt = now;
+        swap(scene);
+      }
+      composer.render();
+    },
+    dispose() {
+      for (const m of made) m.dispose();
+      made.clear();
+      env?.dispose();
+      composer?.dispose();
+      ao?.dispose?.();
+      smaa?.dispose?.();
+      bloom?.dispose?.();
+    },
+  };
+}
