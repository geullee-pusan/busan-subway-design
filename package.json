{
  "name": "busan-subway-design",
  "version": "0.0.0",
  "private": true,
  "description": "부산 도시철도 설계 게임",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-dist.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "fetch": "node scripts/fetch.mjs",
    "data": "node scripts/build-data.mjs",
    "validate": "node scripts/validate.mjs",
    "calibrate": "node scripts/calibrate.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "tablet": "vite preview --port 4173 --strictPort --host",
    "icons": "node scripts/make-icons.mjs",
    "ride-assets": "node scripts/ride-assets.mjs",
    "melodies": "node scripts/make-melodies.mjs",
    "history-population": "node scripts/build-history-population.mjs",
    "bus": "node scripts/build-bus.mjs",
    "station-sounds": "node scripts/build-station-sounds.mjs",
    "api-key": "node scripts/api-key.mjs",
    "rail": "node scripts/build-rail.mjs && node scripts/build-trains.mjs",
    "station-areas": "node scripts/build-station-areas.mjs",
    "trains": "node scripts/fetch-trains.mjs",
    "train-fares": "node scripts/fetch-train-extras.mjs",
    "roads": "node scripts/build-roads.mjs",
    "tago-bus": "node scripts/fetch-tago-bus.mjs",
    "bus-hours": "node scripts/fetch-bus-hours.mjs",
    "dong-shapes": "node scripts/build-dong-shapes.mjs",
    "water-shapes": "node scripts/build-water-shapes.mjs",
    "landmarks": "node scripts/build-landmarks.mjs",
    "intercity": "node scripts/fetch-intercity.mjs",
    "intercity-build": "node scripts/build-intercity.mjs",
    "hero": "node scripts/hero-bake.mjs",
    "hero-3d": "node scripts/hero-pack.mjs",
    "bus-looks": "node scripts/build-bus-looks.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3"
  }
}
